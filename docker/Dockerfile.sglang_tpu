FROM us-central1-docker.pkg.dev/YOUR_GCP_PROJECT_ID/vllm/vllm-torchtpu-bench:v0.32.0

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgl1 libglib2.0-0 libsndfile1 gcc g++ make git curl netcat-openbsd && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/sgl-project/sglang-torchtpu.git /workspace/sglang

COPY prep_sglang_tpu.py /tmp/prep_sglang_tpu.py
RUN python3 /tmp/prep_sglang_tpu.py

RUN uv pip install --system -c /tmp/tpu_abi_constraints.txt "/workspace/sglang/python[diffusion_tpu,all_tpu,ray,runai]" && uv pip install --system --no-deps /workspace/sglang && python3 -c "import importlib.metadata as md, shutil, torch, torch_tpu, jax, sglang, sglang_tpu, av, cv2, diffusers; assert shutil.which('ffmpeg') and shutil.which('ffprobe'); print('SGLANG_TPU_BUILD_OK', torch.__version__, md.version('torch-tpu'), jax.__version__)"

WORKDIR /workspace
CMD ["/bin/bash"]
